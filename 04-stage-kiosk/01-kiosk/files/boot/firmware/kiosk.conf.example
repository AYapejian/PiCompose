# /boot/firmware/kiosk.conf — per-device kiosk configuration.
#
# Copy this file to kiosk.conf (no .example) on the FAT32 partition
# before first boot, or any time later from any laptop with the SD
# card mounted. start-kiosk.sh sources it at every cage launch.

# === Default: LAN over plain HTTP ===
# Home Assistant is HTTP-only by default (no cert config in
# configuration.yaml = no HTTPS). Pointing at https:// without an
# explicit http: block + cert gets Chromium ERR_SSL_PROTOCOL_ERROR.
KIOSK_URL=http://192.168.1.210:8123

# === Alternative: LAN over HTTPS (if you've configured a cert in HA) ===
# --ignore-certificate-errors in start-kiosk.sh handles HA's
# self-signed cert if you go this route.
# KIOSK_URL=https://192.168.1.210:8123

# === Alternative: Nabu Casa relay ===
# Use when the kiosk is OFF the home LAN. Adds 30-100ms relay latency
# per request and runs every websocket entity update through the relay.
# KIOSK_URL=https://lgthcmaysohssmsk9tvq7pz96zocz7oa.ui.nabu.casa/

# === Per-device dashboard / app-mode flags ===
# Useful for room-specific dashboards, e.g.
#   /lovelace/kiosk-livingroom
#   /lovelace-mobile/0
# Examples (uncomment one):
# EXTRA_FLAGS="--app=https://192.168.1.210:8123/lovelace/kiosk-livingroom"
# EXTRA_FLAGS="--lang=en-US --force-device-scale-factor=1.25"
