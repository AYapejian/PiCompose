#!/usr/bin/env bash
# xvf3800-led — stub LED control daemon for the reSpeaker XVF3800.
#
# This is a placeholder. By default this script just sets a steady "idle"
# color on boot and exits. Wiring it to LVA's wake-word state via the
# ESPHome API is a documented follow-up; until then this script proves
# `xvf_host` works on the device.
#
# To use the LEDs interactively after boot:
#   xvf_host SET_LED_RING_EFFECT <effect-id>
#
# Find the device with: lsusb | grep -iE 'xmos|xvf'

set -euo pipefail

# Wait up to 30s for the device to enumerate after boot (USB takes a
# moment, and on a cold boot we may run before udev settles).
for _ in $(seq 1 30); do
    if lsusb | grep -qiE 'xmos|xvf'; then
        break
    fi
    sleep 1
done

# Try a steady "idle" effect. Verb names vary by firmware revision —
# don't hard-fail if it's not what this firmware expects, just log and exit.
if command -v xvf_host >/dev/null 2>&1; then
    xvf_host SET_LED_RING_EFFECT 1 \
        || echo "xvf3800-led: xvf_host LED command not validated for this firmware" >&2
else
    echo "xvf3800-led: xvf_host CLI not installed; skipping" >&2
fi

exit 0
