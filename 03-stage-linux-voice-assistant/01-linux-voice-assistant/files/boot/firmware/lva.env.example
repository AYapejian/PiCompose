# /boot/firmware/lva.env — per-device LVA overrides.
#
# Copy this file to lva.env (no .example) on the FAT32 partition to
# override LVA's defaults without ever SSHing into the device. The
# lva-env-sync.service copies whatever is here onto /compose/lva/.env
# before picompose.service deploys the LVA container.
#
# Only the keys you set here are pinned; anything you leave commented
# falls back to the bundled /compose/lva/.env defaults (which are
# already tuned for the reSpeaker XVF3800).

### Friendly name announced to Home Assistant via mDNS.
### Default uses the device hostname; uncomment to pin a different name.
# CLIENT_NAME="kiosk-livingroom"

### Wake word model. LVA bundles "okay_nabu" (default), "hey_jarvis",
### "alexa". Custom .tflite models can be added via /compose/lva/wakeword
### volumes; see the OHF-Voice/linux-voice-assistant README.
# WAKE_MODEL="okay_nabu"

### XVF3800 does these in hardware. Leave at "0" unless you've replaced
### the audio device with something that doesn't have on-board DSP.
# MIC_AUTO_GAIN="0"
# MIC_NOISE_SUPPRESSION="0"

### Pin a specific image tag (e.g., to lock to a release):
# LVA_IMAGE="ghcr.io/ohf-voice/linux-voice-assistant"
# LVA_IMAGE_TAG="v1.4.0"

### Enable LVA debug logging:
# ENABLE_DEBUG="1"
