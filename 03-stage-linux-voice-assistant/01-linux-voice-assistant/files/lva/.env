# Linux-Voice-Assistant — runtime environment for ara-kiosk-image.
#
# Defaults below are tuned for the reSpeaker XVF3800 USB-4MIC ARRAY.
# Edit /boot/firmware/lva.env on the FAT32 partition to override these
# without SSHing in — lva-env-sync.service copies it onto /compose/lva/.env
# before picompose.service runs.

### Docker image (overridable):
# LVA_IMAGE="ghcr.io/ohf-voice/linux-voice-assistant"
# LVA_IMAGE_TAG="latest"

### Debug logging.
### REQUIRED for xvf3800-led-bridge.service to see voice-pipeline state
### transitions — those fire at DEBUG level only ("Voice event: type=...").
### If you turn this off, the LED bridge will only react to wake-word
### activation (logged at INFO) and TTS playback, not the intermediate
### thinking phase.
ENABLE_DEBUG="1"

### User / group for the LVA container (must match the host pi user
### so it can read the PipeWire/Pulse socket):
LVA_USER_ID="1000"
LVA_USER_GROUP="1000"

### Friendly name announced via mDNS / shown in Home Assistant.
### Defaults to the system hostname so per-device naming works just by
### setting the hostname in Imager (compose-manager.sh exports HOSTNAME
### before `docker compose up`).
CLIENT_NAME="${HOSTNAME:-kiosk}"

### PulseAudio / PipeWire socket paths on the host:
LVA_PULSE_SERVER="/run/user/${LVA_USER_ID}/pulse/native"
LVA_XDG_RUNTIME_DIR="/run/user/${LVA_USER_ID}"
LVA_PULSE_COOKIE="/run/user/${LVA_USER_ID}/pulse/cookie"

### Wake word model. Set explicitly so it shows up in `docker inspect`
### and is greppable; overridable via /boot/firmware/lva.env.
WAKE_MODEL="okay_nabu"

### XVF3800 hardware does AGC + noise suppression + AEC on-board.
### DO NOT enable software AGC/NS here — doubling up degrades STT
### accuracy noticeably.
MIC_AUTO_GAIN="0"
MIC_NOISE_SUPPRESSION="0"
